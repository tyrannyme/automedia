{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "automedia-site",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "public",
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "automedia.tyranny.me", "custom_domain": true }],
  "workers_dev": false,
}
