    "@strudel/web": "1.2.8",
    "@tailwindcss/browser": "4.3.3",
    "@tanstack/react-router": "1.170.25",
    "better-result": "^3.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "13.1.0",
    "motion": "13.1.0",
    "motion-dom": "13.0.0",
    "motion-utils": "13.0.0",
    "playwright": "1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "three": "0.185.1",
    "tw-animate-css": "1.4.0",
    "valibot": "1.4.2",
    "vgpu": "0.3.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-base": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@oxlint/plugins": "1.78.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.4",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
