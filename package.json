    "oxlint": "1.78.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.15.1",
  "build": {
    "appId": "dev.automedia.app",
    "productName": "Automedia",
